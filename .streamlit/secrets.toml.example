# Copy this file to .streamlit/secrets.toml and fill in real values.
# secrets.toml is gitignored and must never be committed.
# When deployed, set these in the host's secrets manager instead of in a file.

OPENAI_API_KEY = "sk-REPLACE-ME"

# Shared team password for the dashboard. The app refuses to start without it.
APP_PASSWORD = "REPLACE-with-a-long-passphrase"

# Optional. Free tier (~10k units/day). Powers the YouTube panel on the Live
# Pulse page — the page works without it, just without that one section.
YOUTUBE_API_KEY = "AIza-REPLACE-ME"

# Optional. Free, read-only. Create a "script" type app at
# reddit.com/prefs/apps to get these — the client ID is the string under the
# app's name, the secret is labeled "secret". Powers the Reddit panel on the
# Live Pulse page — the page works without it, just without that one section.
REDDIT_CLIENT_ID = "REPLACE-ME"
REDDIT_CLIENT_SECRET = "REPLACE-ME"

# Optional but recommended. From your Supabase project's Settings -> API page.
# SUPABASE_SERVICE_KEY is the "service_role" secret key (NOT the "anon" public
# key — RLS blocks anon entirely by design, this app needs the service role
# key to read its own data). Without these, the app falls back to Book 13.xlsx.
SUPABASE_URL = "https://REPLACE-ME.supabase.co"
SUPABASE_SERVICE_KEY = "REPLACE-ME"
